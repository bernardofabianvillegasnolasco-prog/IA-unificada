# Copia este archivo como .env y completa solo lo necesario.

# Proveedor compatible con la API de OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5

# Segundo proveedor opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Tercer proveedor opcional
GOOGLE_API_KEY=
GOOGLE_MODEL=

# Persistencia local
IA_MEMORY_DIR=memory
IA_LOG_DIR=logs
